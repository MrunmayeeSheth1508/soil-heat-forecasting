{"data":{"id":"10.48328/tudatalib-665","type":"dois","attributes":{"doi":"10.48328/tudatalib-665","prefix":"10.48328","suffix":"tudatalib-665","identifiers":[],"alternateIdentifiers":[],"creators":[{"name":"Verschaffel-Drefke, Christoph","nameType":"Personal","givenName":"Christoph","familyName":"Verschaffel-Drefke","nameIdentifiers":[{"schemeUri":"https://orcid.org","nameIdentifier":"https://orcid.org/0000-0002-8538-7667","nameIdentifierScheme":"ORCID"}],"affiliation":[]},{"name":"Schedel, Markus","nameType":"Personal","givenName":"Markus","familyName":"Schedel","nameIdentifiers":[{"schemeUri":"https://orcid.org","nameIdentifier":"https://orcid.org/0000-0001-6596-831X","nameIdentifierScheme":"ORCID"}],"affiliation":[]},{"name":"Balzer, Constantin","nameType":"Personal","givenName":"Constantin","familyName":"Balzer","affiliation":[],"nameIdentifiers":[]},{"name":"Hinrichsen, Volker","nameType":"Personal","givenName":"Volker","familyName":"Hinrichsen","affiliation":[],"nameIdentifiers":[]},{"name":"Sass, Ingo","nameType":"Personal","givenName":"Ingo","familyName":"Sass","affiliation":[],"nameIdentifiers":[]},{"name":"TU Darmstadt","nameType":"Organizational","affiliation":[],"nameIdentifiers":[{"schemeUri":"https://ror.org","nameIdentifier":"https://ror.org/05n911h24","nameIdentifierScheme":"ROR"}]}],"titles":[{"title":"Supplementary Information to ‘Heat Dissipation in variable Underground Power Cable Beddings: Experiences from a Real Scale Field Experiment'"}],"publisher":"Technical University of Darmstadt","container":{},"publicationYear":2021,"subjects":[{"subject":"Ampacity Rating"},{"subject":"Bedding Material"},{"subject":"Field Experiment"},{"subject":"Heat Dissipation"},{"subject":"Thermal Cable Rating"},{"subject":"Underground Power Cable"},{"lang":"de","subject":"314-01 Geologie, Ingenieurgeologie, Paläontologie","schemeUri":"https://www.dfg.de/dfg_profil/gremien/fachkollegien/faecher","subjectScheme":"DFG"},{"lang":"en","subject":"314-01 Geology and Palaeontology","schemeUri":"https://www.dfg.de/en/dfg_profile/statutory_bodies/review_boards/subject_areas/index.jsp","subjectScheme":"DFG"},{"lang":"de","subject":"318-01 Hydrogeologie, Hydrologie, Limnologie, Siedlungswasserwirtschaft, Wasserchemie, Integrierte Wasser-Ressourcen Bewirtschaftung","schemeUri":"https://www.dfg.de/dfg_profil/gremien/fachkollegien/faecher","subjectScheme":"DFG"},{"lang":"en","subject":"318-01 Hydrogeology, Hydrology, Limnology, Urban Water Management, Water Chemistry, Integrated Water Resources Management","schemeUri":"https://www.dfg.de/en/dfg_profile/statutory_bodies/review_boards/subject_areas/index.jsp","subjectScheme":"DFG"},{"lang":"de","subject":"408-03 Elektrische Energieerzeugung, -übertragung, -verteilung und -anwendung","schemeUri":"https://www.dfg.de/dfg_profil/gremien/fachkollegien/faecher","subjectScheme":"DFG"},{"lang":"en","subject":"408-03 Electrical Energy Generation, Distribution, Application","schemeUri":"https://www.dfg.de/en/dfg_profile/statutory_bodies/review_boards/subject_areas/index.jsp","subjectScheme":"DFG"},{"subject":"550","schemeUri":"https://www.oclc.org/de/dewey.html","subjectScheme":"DDC"},{"subject":"624","schemeUri":"https://www.oclc.org/de/dewey.html","subjectScheme":"DDC"},{"subject":"621.3","schemeUri":"https://www.oclc.org/de/dewey.html","subjectScheme":"DDC"}],"contributors":[{"name":"Technical University Of Darmstadt","affiliation":[],"contributorType":"HostingInstitution","nameIdentifiers":[]}],"dates":[{"date":"2021-10-27","dateType":"Accepted"},{"date":"2021-10-27","dateType":"Available"},{"date":"2021","dateType":"Created"},{"date":"2021","dateType":"Issued"}],"language":"en","types":{"ris":"DATA","bibtex":"misc","citeproc":"dataset","schemaOrg":"Dataset","resourceType":"Dataset","resourceTypeGeneral":"Dataset"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":null,"rightsList":[{"rights":"Creative Commons Attribution-NonCommercial 4.0"},{"rights":"Creative Commons Attribution Non Commercial 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"The increasing decentralization of electrical energy production as well as an increasing number of fluctuating regenerative energy sources require significant investments in grid expansion. To prevent accelerated thermal aging or insulation faults in cable systems due to overheating, the current carrying capacity is usually limited by specific conductor temperatures. As the heat produced during the operation of underground cables has to be dissipated to the environment, the actual current carrying capacity of a power cable system is primarily dependent on the thermal properties of the surrounding porous bedding material and soil. To investigate the heat dissipation processes around buried power cables in real scale and with realistic electric loading, a field experiment consisting of a main field with various cable configurations, laid in four different bedding materials, and a side field with additional cable trenches for thermal enhanced bedding materials and protection pipe systems was planned and constructed by Verschaffel-Drefke et al. (2021). Both the experimentally determined bedding properties and the presented data of the conducted experiments are provided.","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://tudatalib.ulb.tu-darmstadt.de/handle/tudatalib/3001","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2021-10-28T12:42:16.000Z","registered":"2021-10-28T12:42:25.000Z","published":"2021","updated":"2023-04-05T17:38:58.000Z"},"relationships":{"client":{"data":{"id":"hlqc.znxeli","type":"clients"}},"provider":{"data":{"id":"hlqc","type":"providers"}},"media":{"data":{"id":"10.48328/tudatalib-665","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}